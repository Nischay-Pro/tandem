# Add these upstream declarations inside the nginx http {} context, outside any
# server {} block. The API service name matches docker-compose.dev.yml.
# Set the API's TRUST_PROXY value to the exact address or narrow CIDR Nginx uses
# to reach it, and keep the API origin inaccessible to untrusted clients.

limit_req_zone $binary_remote_addr zone=tandem_pairing:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=tandem_api:10m rate=600r/m;

upstream tandem_api {
    server api:19753;
}

upstream actual_budget_server {
    server actual-server:5006;
}
