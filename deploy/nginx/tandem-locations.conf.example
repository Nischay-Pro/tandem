# Optional: only needed if you run Tandem's extension sync for planning records.
# Copy this location into the existing TLS server block for budget.example.com,
# before the Actual catch-all. Define the upstream with tandem-upstreams.conf.example.
# Tandem's budget data syncs with Actual directly and needs no route here.

location ^~ /extension/v1/ {
    limit_req zone=tandem_api burst=60 nodelay;
    limit_req_status 429;
    client_max_body_size 256k;
    proxy_pass http://tandem_api;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    add_header Cache-Control "no-store" always;
}

# Keep the existing Actual location / proxy settings and COOP/COEP headers.
location / {
    proxy_pass http://actual_budget_server;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}
