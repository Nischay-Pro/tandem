# Copy to deploy/compose/.env and chmod 600 before starting production Compose.
# Use a randomly generated password and URL-encode it in DATABASE_URL.
POSTGRES_DB=tandem
POSTGRES_USER=tandem
POSTGRES_PASSWORD=replace-with-a-random-secret
DATABASE_URL=postgresql://tandem:replace-with-a-random-secret@postgres:5432/tandem

# Generate with: openssl rand -hex 32. Keep this the same for the API and pairing CLI.
PAIRING_CODE_HASH_KEY=replace-with-output-of-openssl-rand-hex-32

# Keep this stable across normal restarts. After restoring an older DB backup,
# change it to a new random value before starting the API.
CHANGE_FEED_EPOCH=replace-with-a-random-stable-value

# Set this to the address or narrow CIDR of the trusted reverse proxy on the
# Docker network. Leave empty only when the API is not behind a proxy.
TRUST_PROXY=
TANDEM_EDGE_NETWORK=tandem-edge

# Optional. The Actual server must match the pinned compatibility version.
ACTUAL_SERVER_URL=
ACTUAL_SERVER_PASSWORD=
