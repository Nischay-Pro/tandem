# Copy to deploy/compose/.env and chmod 600. Secret values belong in files in
# deploy/compose/secrets/, not in this environment file.
TANDEM_POSTGRES_DB=tandem
TANDEM_POSTGRES_USER=tandem
# The setup command writes this as a digest-pinned GHCR reference.
TANDEM_API_IMAGE=
TANDEM_POSTGRES_PASSWORD_FILE=deploy/compose/secrets/postgres_password
TANDEM_DATABASE_URL_FILE=deploy/compose/secrets/database_url
# Leave this empty for normal per-person sign-in. Fill it only when the API
# needs an operator-managed Actual session at startup.
TANDEM_ACTUAL_SESSION_TOKEN_FILE=deploy/compose/secrets/actual_session_token
TANDEM_AUTH_TOKEN_ENCRYPTION_KEY_FILE=deploy/compose/secrets/auth_token_encryption_key
# Keep this file zero bytes normally; set it to the previous key during rotation.
TANDEM_AUTH_TOKEN_ENCRYPTION_KEY_PREVIOUS_FILE=deploy/compose/secrets/auth_token_encryption_key_previous

# Set this to the exact reverse proxy IP or narrow CIDR seen by the API.
# Leave empty unless the reverse proxy's client address should be trusted.
TANDEM_TRUST_PROXY=
TANDEM_EDGE_NETWORK=tandem-edge

# Actual server must match the pinned compatibility version.
TANDEM_ACTUAL_SERVER_URL=
# Required for Actual OpenID sign-in. Use the public Tandem URL served through
# the reverse proxy; password sign-in works without it.
TANDEM_ACTUAL_PUBLIC_URL=
