# Copy to deploy/compose/.env and chmod 600. Secret values belong in files in
# deploy/compose/secrets/, not in this environment file.
POSTGRES_DB=tandem
POSTGRES_USER=tandem
POSTGRES_PASSWORD_FILE=deploy/compose/secrets/postgres_password
DATABASE_URL_FILE=deploy/compose/secrets/database_url
# Leave this empty for normal per-person sign-in. Fill it only when the API
# needs an operator-managed Actual session at startup.
ACTUAL_SESSION_TOKEN_FILE=deploy/compose/secrets/actual_session_token
AUTH_TOKEN_ENCRYPTION_KEY_FILE=deploy/compose/secrets/auth_token_encryption_key
# Keep this file zero bytes normally; set it to the previous key during rotation.
AUTH_TOKEN_ENCRYPTION_KEY_PREVIOUS_FILE=deploy/compose/secrets/auth_token_encryption_key_previous

# Set this to the exact reverse proxy IP or narrow CIDR seen by the API.
# Production Compose refuses an empty value.
TRUST_PROXY=
TANDEM_EDGE_NETWORK=tandem-edge

# Actual server must match the pinned compatibility version.
ACTUAL_SERVER_URL=
# Required for Actual OpenID sign-in. Use the public Tandem URL served through
# the reverse proxy; password sign-in works without it.
ACTUAL_PUBLIC_URL=
