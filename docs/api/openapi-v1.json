    "/api/v1/budgets/{budgetId}/transactions/{transactionId}/operations": {
      "post": {
        "operationId": "submitTransactionOperation",
        "summary": "Submit an idempotent, revision-checked transaction update or deletion",
        "tags": ["Transactions"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "operationId": { "type": "string", "format": "uuid" },
                  "action": { "type": "string", "enum": ["update", "delete"] },
                  "baseRevision": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  },
                  "baseSnapshot": {
                    "type": "object",
                    "additionalProperties": true,
                    "maxProperties": 20
                  },
                  "patch": {
                    "type": "object",
                    "additionalProperties": true,
                    "maxProperties": 8
                  }
                },
                "required": [
                  "operationId",
                  "action",
                  "baseRevision",
                  "baseSnapshot",
                  "patch"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f]+$"
            },
            "in": "path",
            "name": "budgetId",
            "required": true
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f]+$"
            },
            "in": "path",
            "name": "transactionId",
            "required": true
          },
          {
            "schema": { "type": "string", "minLength": 1, "maxLength": 1024 },
            "in": "header",
            "name": "x-budget-encryption-password",
            "required": false
          },
          {
            "schema": { "type": "string", "minLength": 1, "maxLength": 500 },
            "in": "header",
            "name": "idempotency-key",
            "required": true
          }
        ],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "operation": {
                      "type": "object",
                      "properties": {
                        "operationId": { "type": "string", "format": "uuid" },
                        "budgetId": { "type": "string" },
                        "action": {
                          "type": "string",
                          "enum": ["update", "delete"]
                        },
                        "transactionId": { "type": "string" },
                        "baseRevision": { "type": "string" },
                        "baseSnapshot": {
                          "type": "object",
                          "additionalProperties": true
                        },
                        "patch": {
                          "type": "object",
                          "additionalProperties": true
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "queued",
                            "applying",
                            "committed",
                            "conflict",
                            "uncertain",
                            "rejected"
                          ]
                        },
                        "attemptCount": { "type": "integer" },
                        "errorCode": { "type": ["null", "string"] },
                        "actualResult": {
                          "type": [
                            "null",
                            "object",
                            "array",
                            "string",
                            "number",
                            "boolean"
                          ]
                        },
                        "createdAt": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "updatedAt": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "startedAt": {
                          "type": ["null", "string"],
                          "format": "date-time"
                        },
                        "completedAt": {
                          "type": ["null", "string"],
                          "format": "date-time"
                        }
                      },
                      "required": [
                        "operationId",
                        "budgetId",
                        "action",
                        "transactionId",
                        "baseRevision",
                        "baseSnapshot",
                        "patch",
                        "status",
                        "attemptCount",
                        "errorCode",
                        "actualResult",
                        "createdAt",
                        "updatedAt",
                        "startedAt",
                        "completedAt"
                      ],
                      "additionalProperties": false
                    },
                    "conflict": {
                      "type": ["null", "object"],
                      "properties": {
                        "conflictId": { "type": "string", "format": "uuid" },
                        "conflictType": { "type": "string" },
                        "baseSnapshot": {
                          "type": "object",
                          "additionalProperties": true
                        },
                        "localPatch": {
                          "type": "object",
                          "additionalProperties": true
                        },
                        "remoteSnapshot": {
                          "anyOf": [
                            {
                              "type": "object",
                              "properties": {
                                "id": { "type": "string" },
                                "account": { "type": "string" },
                                "amount": { "type": "integer" },
                                "date": { "type": "string", "format": "date" },
                                "payee": { "type": ["null", "string"] },
                                "category": { "type": ["null", "string"] },
                                "notes": { "type": ["null", "string"] },
                                "cleared": { "type": ["null", "boolean"] },
                                "reconciled": { "type": ["null", "boolean"] },
                                "importedId": { "type": ["null", "string"] },
                                "importedPayee": { "type": ["null", "string"] },
                                "startingBalance": {
                                  "type": ["null", "boolean"]
                                },
                                "schedule": { "type": ["null", "string"] },
                                "transferId": { "type": ["null", "string"] },
                                "isParent": { "type": "boolean" },
                                "isChild": { "type": "boolean" },
                                "parentId": { "type": ["null", "string"] },
                                "subtransactions": {
                                  "type": "array",
                                  "maxItems": 1000,
                                  "items": {
                                    "type": "object",
                                    "additionalProperties": true
                                  }
                                }
                              },
                              "required": [
                                "id",
                                "account",
                                "amount",
                                "date",
                                "payee",
                                "category",
                                "notes",
                                "cleared",
                                "reconciled",
                                "importedId",
                                "importedPayee",
                                "startingBalance",
                                "schedule",
                                "transferId",
                                "isParent",
                                "isChild",
                                "parentId",
                                "subtransactions"
                              ],
                              "additionalProperties": false
                            },
                            { "type": "null" }
                          ]
                        },
                        "conflictingFields": {
                          "type": "array",
                          "items": { "type": "string" }
                        },
                        "createdAt": { "type": "string", "format": "date-time" }
                      },
                      "required": [
                        "conflictId",
                        "conflictType",
                        "baseSnapshot",
                        "localPatch",
                        "remoteSnapshot",
                        "conflictingFields",
                        "createdAt"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": ["operation", "conflict"],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": { "type": "string" },
                        "message": { "type": "string" }
                      },
                      "required": ["code", "message"],
                      "additionalProperties": false
                    }
                  },
                  "required": ["error"],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": { "type": "string" },
