    "/api/v1/budgets/{budgetId}/transactions/{transactionId}": {
      "get": {
        "operationId": "getBudgetTransaction",
        "summary": "Read one transaction and its optimistic concurrency revision",
        "tags": ["Transactions"],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f]+$"
            },
            "in": "path",
            "name": "budgetId",
            "required": true
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f]+$"
            },
            "in": "path",
            "name": "transactionId",
            "required": true
          },
          {
            "schema": { "type": "string", "minLength": 1, "maxLength": 1024 },
            "in": "header",
            "name": "x-budget-encryption-password",
            "required": false
          }
        ],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "transaction": {
                      "type": "object",
                      "properties": {
                        "id": { "type": "string" },
                        "account": { "type": "string" },
                        "amount": { "type": "integer" },
                        "date": { "type": "string", "format": "date" },
                        "payee": { "type": ["null", "string"] },
                        "category": { "type": ["null", "string"] },
                        "notes": { "type": ["null", "string"] },
                        "cleared": { "type": ["null", "boolean"] },
                        "reconciled": { "type": ["null", "boolean"] },
                        "importedId": { "type": ["null", "string"] },
                        "importedPayee": { "type": ["null", "string"] },
                        "startingBalance": { "type": ["null", "boolean"] },
                        "schedule": { "type": ["null", "string"] },
                        "transferId": { "type": ["null", "string"] },
                        "isParent": { "type": "boolean" },
                        "isChild": { "type": "boolean" },
                        "parentId": { "type": ["null", "string"] },
                        "subtransactions": {
                          "type": "array",
                          "maxItems": 1000,
                          "items": {
                            "type": "object",
                            "additionalProperties": true
                          }
                        }
                      },
                      "required": [
                        "id",
                        "account",
                        "amount",
                        "date",
                        "payee",
                        "category",
                        "notes",
                        "cleared",
                        "reconciled",
                        "importedId",
                        "importedPayee",
                        "startingBalance",
                        "schedule",
                        "transferId",
                        "isParent",
                        "isChild",
                        "parentId",
                        "subtransactions"
                      ],
                      "additionalProperties": false
                    },
                    "revision": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    }
                  },
                  "required": ["transaction", "revision"],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": { "type": "string" },
                        "message": { "type": "string" }
                      },
                      "required": ["code", "message"],
                      "additionalProperties": false
                    }
                  },
                  "required": ["error"],
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": { "type": "string" },
                        "message": { "type": "string" }
                      },
                      "required": ["code", "message"],
                      "additionalProperties": false
                    }
                  },
                  "required": ["error"],
                  "additionalProperties": false
                }
              }
            }
          },
          "404": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": { "type": "string" },
                        "message": { "type": "string" }
                      },
                      "required": ["code", "message"],
                      "additionalProperties": false
                    }
                  },
                  "required": ["error"],
                  "additionalProperties": false
                }
              }
            }
          },
          "502": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": { "type": "string" },
                        "message": { "type": "string" }
                      },
                      "required": ["code", "message"],
                      "additionalProperties": false
                    }
                  },
                  "required": ["error"],
