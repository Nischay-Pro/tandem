{
  "openapi": "3.0.3",
  "info": {
    "title": "Tandem extension sync",
    "version": "1.0.0",
    "description": "Optional encrypted sync for Tandem planning records. Budget data syncs with Actual directly."
  },
  "components": {
    "securitySchemes": {
      "actualToken": {
        "type": "apiKey",
        "in": "header",
        "name": "x-actual-token"
      }
    },
    "schemas": {}
  },
  "paths": {
    "/extension/v1/health/live": {
      "get": {
        "operationId": "getLiveness",
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "status": { "type": "string" } }
                }
              }
            }
          }
        }
      }
    },
    "/extension/v1/health/ready": {
      "get": {
        "operationId": "getReadiness",
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "status": { "type": "string" } }
                }
              }
            }
          },
          "503": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": { "type": "string" },
                        "message": { "type": "string" }
                      },
                      "required": ["code", "message"]
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          }
        }
      }
    },
    "/extension/v1/capabilities": {
      "get": {
        "operationId": "getCapabilities",
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "apiVersion": { "type": "integer" },
                    "features": {
                      "type": "array",
                      "items": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/extension/v1/budgets/{budgetId}/key": {
      "get": {
        "operationId": "getPlanningKey",
        "parameters": [
          {
            "schema": { "type": "string", "pattern": "^[A-Za-z0-9-]{1,100}$" },
            "in": "path",
            "name": "budgetId",
            "required": true
          }
        ],
        "security": [{ "actualToken": [] }],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "keyId": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 64
                    },
                    "wrappedKey": {
                      "type": "string",
                      "maxLength": 65536,
                      "pattern": "^[A-Za-z0-9+/]*={0,2}$"
                    },
                    "wrapSalt": {
                      "type": "string",
                      "maxLength": 65536,
                      "pattern": "^[A-Za-z0-9+/]*={0,2}$"
                    },
                    "keyCheck": {
                      "type": "string",
                      "maxLength": 65536,
                      "pattern": "^[A-Za-z0-9+/]*={0,2}$"
                    }
                  },
                  "required": ["keyId", "wrappedKey", "wrapSalt", "keyCheck"]
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": { "type": "string" },
                        "message": { "type": "string" }
                      },
                      "required": ["code", "message"]
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          },
          "403": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": { "type": "string" },
                        "message": { "type": "string" }
                      },
                      "required": ["code", "message"]
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          },
          "404": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": { "type": "string" },
                        "message": { "type": "string" }
                      },
                      "required": ["code", "message"]
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          },
          "503": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": { "type": "string" },
                        "message": { "type": "string" }
                      },
                      "required": ["code", "message"]
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "putPlanningKey",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "keyId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "wrappedKey": {
                    "type": "string",
                    "maxLength": 65536,
                    "pattern": "^[A-Za-z0-9+/]*={0,2}$"
                  },
                  "wrapSalt": {
                    "type": "string",
                    "maxLength": 65536,
                    "pattern": "^[A-Za-z0-9+/]*={0,2}$"
                  },
                  "keyCheck": {
                    "type": "string",
                    "maxLength": 65536,
                    "pattern": "^[A-Za-z0-9+/]*={0,2}$"
                  },
                  "expectedKeyId": { "type": "string", "nullable": true }
                },
                "required": [
                  "keyId",
                  "wrappedKey",
                  "wrapSalt",
                  "keyCheck",
                  "expectedKeyId"
                ]
              }
            }
          }
        },
        "parameters": [
          {
            "schema": { "type": "string", "pattern": "^[A-Za-z0-9-]{1,100}$" },
            "in": "path",
            "name": "budgetId",
            "required": true
          }
        ],
        "security": [{ "actualToken": [] }],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "status": { "type": "string" } }
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": { "type": "string" },
                        "message": { "type": "string" }
                      },
                      "required": ["code", "message"]
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          },
          "403": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": { "type": "string" },
                        "message": { "type": "string" }
                      },
                      "required": ["code", "message"]
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          },
          "409": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": { "type": "string" },
                        "message": { "type": "string" }
                      },
                      "required": ["code", "message"]
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          },
          "503": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": { "type": "string" },
                        "message": { "type": "string" }
                      },
                      "required": ["code", "message"]
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          }
        }
      }
    },
    "/extension/v1/budgets/{budgetId}/changes": {
      "get": {
        "operationId": "getPlanningChanges",
        "parameters": [
          {
            "schema": { "type": "integer", "minimum": 0 },
            "in": "query",
            "name": "after",
            "required": false
          },
          {
            "schema": { "type": "integer", "minimum": 1, "maximum": 500 },
            "in": "query",
            "name": "limit",
            "required": false
          },
          {
            "schema": { "type": "string", "pattern": "^[A-Za-z0-9-]{1,100}$" },
            "in": "query",
            "name": "anchor",
            "required": false
          },
          {
            "schema": { "type": "string", "pattern": "^[A-Za-z0-9-]{1,100}$" },
            "in": "path",
            "name": "budgetId",
            "required": true
          }
        ],
        "security": [{ "actualToken": [] }],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "records": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "recordId": { "type": "string" },
                          "recordType": { "type": "string" },
                          "schemaVersion": { "type": "integer" },
                          "revision": { "type": "integer" },
                          "deleted": { "type": "boolean" },
                          "iv": { "type": "string" },
                          "ciphertext": { "type": "string" },
                          "seq": { "type": "integer" }
                        },
                        "required": [
                          "recordId",
                          "recordType",
                          "schemaVersion",
                          "revision",
                          "deleted",
                          "iv",
                          "ciphertext",
                          "seq"
                        ]
                      }
                    },
                    "cursor": { "type": "integer" },
                    "hasMore": { "type": "boolean" },
                    "restored": { "type": "boolean" }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": { "type": "string" },
                        "message": { "type": "string" }
                      },
                      "required": ["code", "message"]
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          },
          "403": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": { "type": "string" },
                        "message": { "type": "string" }
                      },
                      "required": ["code", "message"]
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          },
          "503": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": { "type": "string" },
                        "message": { "type": "string" }
                      },
                      "required": ["code", "message"]
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          }
        }
      }
    },
    "/extension/v1/budgets/{budgetId}/records/{recordId}": {
      "put": {
        "operationId": "putPlanningRecord",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "recordType": {
                    "type": "string",
                    "pattern": "^[a-z_.]{1,64}$"
                  },
                  "schemaVersion": { "type": "integer", "minimum": 1 },
                  "revision": { "type": "integer", "minimum": 1 },
                  "baseRevision": {
                    "type": "integer",
                    "minimum": 1,
                    "nullable": true
                  },
                  "deleted": { "type": "boolean" },
                  "iv": {
                    "type": "string",
                    "maxLength": 65536,
                    "pattern": "^[A-Za-z0-9+/]*={0,2}$"
                  },
                  "ciphertext": {
                    "type": "string",
                    "maxLength": 65536,
                    "pattern": "^[A-Za-z0-9+/]*={0,2}$"
                  }
                },
                "required": [
                  "recordType",
                  "schemaVersion",
                  "revision",
                  "baseRevision",
                  "deleted",
                  "iv",
                  "ciphertext"
                ]
              }
            }
          }
        },
        "parameters": [
          {
            "schema": { "type": "string", "pattern": "^[A-Za-z0-9-]{1,100}$" },
            "in": "path",
            "name": "budgetId",
            "required": true
          },
          {
            "schema": { "type": "string", "pattern": "^[A-Za-z0-9-]{1,100}$" },
            "in": "path",
            "name": "recordId",
            "required": true
          }
        ],
        "security": [{ "actualToken": [] }],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "seq": { "type": "integer" } }
                }
              }
            }
          },
          "401": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": { "type": "string" },
                        "message": { "type": "string" }
                      },
                      "required": ["code", "message"]
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          },
          "403": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": { "type": "string" },
                        "message": { "type": "string" }
                      },
                      "required": ["code", "message"]
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          },
          "409": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": { "type": "string" },
                        "message": { "type": "string" }
                      },
                      "required": ["code", "message"]
                    },
                    "current": {
                      "type": "object",
                      "properties": {
                        "recordId": { "type": "string" },
                        "recordType": { "type": "string" },
                        "schemaVersion": { "type": "integer" },
                        "revision": { "type": "integer" },
                        "deleted": { "type": "boolean" },
                        "iv": { "type": "string" },
                        "ciphertext": { "type": "string" },
                        "seq": { "type": "integer" }
                      },
                      "required": [
                        "recordId",
                        "recordType",
                        "schemaVersion",
                        "revision",
                        "deleted",
                        "iv",
                        "ciphertext",
                        "seq"
                      ],
                      "nullable": true
                    }
                  }
                }
              }
            }
          },
          "503": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": { "type": "string" },
                        "message": { "type": "string" }
                      },
                      "required": ["code", "message"]
                    }
                  },
                  "required": ["error"]
                }
              }
            }
          }
        }
      }
    }
  }
