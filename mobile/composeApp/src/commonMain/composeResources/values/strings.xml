    <string name="watch_intro">Your watch shows left to spend, a few categories and the next bills from the budget on this device. It never signs in, and it keeps no password or budget of its own.</string>
    <string name="watch_categories">Categories on the watch</string>
    <string name="watch_categories_detail">Choose up to 6. Without a choice, the watch shows the categories pinned on the budget.</string>
    <string name="watch_categories_empty">Open the budget on this device to choose categories.</string>
    <string name="watch_quick_add">Quick add from the watch</string>
    <string name="watch_quick_add_detail">Transactions added on the watch go into the open budget once the watch reaches this device. Change History names them Watch.</string>
    <string name="watch_after_unlock">Update the watch only after unlock</string>
    <string name="watch_after_unlock_detail">Background syncs leave the watch as it was; it updates after you open and unlock Tandem.</string>
