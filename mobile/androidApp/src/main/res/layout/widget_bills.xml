<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_background"
  android:clipToOutline="true"
  android:orientation="vertical"
  android:paddingStart="18dp"
  android:paddingTop="14dp"
  android:paddingEnd="12dp"
  android:paddingBottom="14dp">

  <TextView
    android:id="@+id/widget_budget_name"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:ellipsize="end"
    android:maxLines="1"
    android:text="@string/widget_bills_label"
    android:textColor="@color/widget_muted"
    android:textSize="13sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/widget_locked"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:text="Open Tandem to see your bills."
    android:textColor="@color/widget_text"
    android:textSize="15sp"
    android:visibility="gone" />

  <LinearLayout
    android:id="@+id/widget_rows"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:orientation="vertical" />
</LinearLayout>
