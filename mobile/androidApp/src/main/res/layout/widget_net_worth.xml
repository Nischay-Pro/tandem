<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_background"
  android:clipToOutline="true"
  android:orientation="vertical"
  android:paddingStart="18dp"
  android:paddingTop="14dp"
  android:paddingEnd="18dp"
  android:paddingBottom="16dp">

  <TextView
    android:id="@+id/widget_budget_name"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:maxLines="1"
    android:text="@string/widget_net_worth_label"
    android:textColor="@color/widget_muted"
    android:textSize="13sp"
    android:textStyle="bold" />

  <TextView
    android:id="@+id/widget_locked"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="center_vertical"
    android:text="Open Tandem to see your net worth."
    android:textColor="@color/widget_text"
    android:textSize="15sp"
    android:visibility="gone" />

  <LinearLayout
    android:id="@+id/widget_amounts"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="bottom"
    android:orientation="vertical">

    <TextView
      android:id="@+id/widget_net_worth"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:maxLines="1"
      android:text="—"
      android:textColor="@color/widget_text"
      android:textSize="24sp"
      android:textStyle="bold" />

    <TextView
      android:id="@+id/widget_net_worth_negative"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:maxLines="1"
      android:text="—"
      android:textColor="@color/widget_negative"
      android:textSize="24sp"
      android:textStyle="bold"
      android:visibility="gone" />

    <TextView
      android:id="@+id/widget_net_worth_detail"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:maxLines="1"
      android:text="Net worth"
      android:textColor="@color/widget_muted"
      android:textSize="12sp" />
  </LinearLayout>
</LinearLayout>
