<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@android:id/background"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_background"
  android:clipToOutline="true"
  android:orientation="vertical"
  android:paddingStart="18dp"
  android:paddingTop="14dp"
  android:paddingEnd="12dp"
  android:paddingBottom="14dp">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:maxLines="1"
      android:text="@string/widget_category_title"
      android:textColor="@color/widget_muted"
      android:textSize="13sp"
      android:textStyle="bold" />

    <ImageView
      android:layout_width="40dp"
      android:layout_height="40dp"
      android:background="@drawable/widget_add_background"
      android:contentDescription="Add transaction"
      android:padding="9dp"
      android:src="@drawable/widget_add" />
  </LinearLayout>

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:gravity="bottom"
    android:orientation="vertical">

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:paddingTop="3dp"
      android:paddingEnd="6dp"
      android:paddingBottom="3dp">

      <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:maxLines="1"
        android:text="Groceries"
        android:textColor="@color/widget_text"
        android:textSize="14sp" />

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="$182.40"
        android:textColor="@color/widget_text"
        android:textSize="14sp"
        android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:paddingTop="3dp"
      android:paddingEnd="6dp"
      android:paddingBottom="3dp">

      <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:maxLines="1"
        android:text="Eating out"
        android:textColor="@color/widget_text"
        android:textSize="14sp" />

      <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="$12.50 over"
        android:textColor="@color/widget_negative"
        android:textSize="14sp"
        android:textStyle="bold" />
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
