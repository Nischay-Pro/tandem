{
  "name": "tandem-for-actual",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "api:dev": "pnpm --filter @tandem-for-actual/api dev",
    "dev:up": "docker compose -f docker-compose.dev.yml up --build",
    "dev:down": "docker compose -f docker-compose.dev.yml down",
    "demo:up": "docker compose -f docker-compose.dev.yml run --build --rm demo-seed",
    "demo:manifest": "node scripts/demo-budget/generate.mjs",
    "api:openapi:generate": "pnpm --filter @tandem-for-actual/api openapi:generate",
    "api:openapi:check": "pnpm --filter @tandem-for-actual/api openapi:check",
    "lint": "eslint .",
    "format:check": "node scripts/check-prettier-files.mjs node_modules/.bin/prettier --all",
    "docs:check": "node scripts/check-docs.mjs",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "test": "pnpm --recursive --if-present test",
    "test:coverage": "pnpm --recursive --if-present test:coverage",
    "test:mutation": "pnpm --filter @tandem-for-actual/api test:mutation",
    "test:mutation:full": "pnpm --filter @tandem-for-actual/api test:mutation:full",
    "test:integration": "docker compose -f docker-compose.dev.yml --profile test run --build --rm integration-tests",
    "check:all": "pnpm api:openapi:check && pnpm docs:check && node --test scripts/check-docs.test.mjs && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@jsquash/webp": "1.4.0",
    "@rei/cedar-icons": "2.6.1",
    "@resvg/resvg-js": "2.6.2",
    "@thesvg/icons": "4.0.13",
    "eslint": "10.15.0",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "prettier": "3.10.1",
    "typescript-eslint": "8.73.0"
  }
}
