FROM node:26.13.0-trixie-slim@sha256:5adad64f9a1fca2d51972caa65983634c8a774eb300d72b20f7f2a0f60368072

WORKDIR /workspace

RUN apt-get update \
    && apt-get install --no-install-recommends -y procps \
    && rm -rf /var/lib/apt/lists/*

RUN npm install --global --allow-scripts=pnpm pnpm@12.16.1 \
    && chown node:node /workspace

COPY --chown=node:node package.json pnpm-workspace.yaml pnpm-lock.yaml .npmrc ./
COPY --chown=node:node services/api/package.json services/api/package.json

USER node
RUN pnpm install --frozen-lockfile

COPY --chown=node:node . .
EXPOSE 19753
CMD ["pnpm", "--filter", "@tandem-for-actual/api", "dev"]
