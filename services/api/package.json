{
  "name": "@tandem-for-actual/api",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/entrypoint.ts",
    "pair": "tsx bin/pairing-cli.ts",
    "pair:production": "node dist-cli/bin/pairing-cli.js",
    "openapi:generate": "tsx --eval 'import { syncOpenApiContract } from \"./src/openapi/contract.ts\"; syncOpenApiContract(\"../../docs/api/openapi-v1.json\").catch((error) => { console.error(error); process.exitCode = 1; });'",
    "openapi:check": "tsx --eval 'import { syncOpenApiContract } from \"./src/openapi/contract.ts\"; syncOpenApiContract(\"../../docs/api/openapi-v1.json\", true).catch((error) => { console.error(error); process.exitCode = 1; });'",
    "build": "tsc -p tsconfig.json && cp src/schema/migrations/ORDER dist/schema/migrations/ORDER && tsc -p tsconfig.cli.json && cp src/schema/migrations/ORDER dist-cli/src/schema/migrations/ORDER",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:actual": "vitest run test/actual-compat.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run --incremental",
    "test:mutation:full": "stryker run --incremental --force"
  },
  "dependencies": {
    "@actual-app/api": "26.10.0",
    "@fastify/swagger": "9.9.2",
    "fastify": "5.12.7",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/typescript-checker": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
