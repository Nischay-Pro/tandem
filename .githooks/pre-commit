#!/usr/bin/env sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

if [ -x "$repo_root/node_modules/.bin/prettier" ]; then
  node scripts/check-prettier-files.mjs "$repo_root/node_modules/.bin/prettier"
elif command -v pnpm >/dev/null 2>&1; then
  node scripts/check-prettier-files.mjs "$(command -v pnpm)"
else
  printf '%s\n' 'Pre-commit checks need the JavaScript dependencies. Run pnpm install first.' >&2
  exit 1
fi

python3 scripts/check-mobile-ui-apostrophes.py
python3 scripts/check-mobile-design-tokens.py
python3 scripts/check-mobile-ui-vocabulary.py

staged_javascript=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(cjs|js|jsx|mjs|cts|mts|ts|tsx)$' || true)
if [ -n "$staged_javascript" ]; then
  if [ ! -x "$repo_root/node_modules/.bin/eslint" ]; then
    printf '%s\n' 'ESLint checks need the JavaScript dependencies. Run pnpm install first.' >&2
    exit 1
  fi
  "$repo_root/node_modules/.bin/eslint" .
fi

staged_api_typescript=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^services/api/.*\.(ts|tsx)$' || true)
if [ -n "$staged_api_typescript" ]; then
  if [ ! -x "$repo_root/node_modules/.bin/tsc" ]; then
    printf '%s\n' 'API type checks need the JavaScript dependencies. Run pnpm install first.' >&2
    exit 1
  fi
  "$repo_root/node_modules/.bin/tsc" --noEmit -p "$repo_root/services/api/tsconfig.json"
  "$repo_root/node_modules/.bin/tsc" --noEmit -p "$repo_root/services/api/tsconfig.test.json"
  node scripts/check-staged-api-coverage.mjs
fi

staged_mobile_kotlin=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^mobile/.*\.(kt|kts)$' || true)
if [ -n "$staged_mobile_kotlin" ]; then
  unstaged_mobile=$(git diff --name-only -- mobile)
  untracked_mobile=$(git ls-files --others --exclude-standard -- mobile)
  if [ -n "$unstaged_mobile$untracked_mobile" ]; then
    printf '%s\n' 'Refusing to commit mobile Kotlin changes while other mobile files are unstaged or untracked.' >&2
    printf '%s\n' 'Stage the complete mobile change so the compile check matches the commit.' >&2
    exit 1
  fi

  if [ -z "${ANDROID_HOME:-}" ]; then
    if [ -n "${ANDROID_SDK_ROOT:-}" ]; then
      ANDROID_HOME=$ANDROID_SDK_ROOT
    else
      for android_sdk_candidate in "$HOME/Android/Sdk" "$HOME/Library/Android/sdk" /usr/lib/android-sdk; do
        if [ -d "$android_sdk_candidate/platforms" ]; then
          ANDROID_HOME=$android_sdk_candidate
          break
        fi
      done
    fi
  fi
  if [ -z "${ANDROID_HOME:-}" ]; then
    printf '%s\n' 'Android compilation needs the SDK. Set ANDROID_HOME to its install directory.' >&2
    exit 1
  fi
  export ANDROID_HOME
  ANDROID_SDK_ROOT=${ANDROID_SDK_ROOT:-$ANDROID_HOME}
  export ANDROID_SDK_ROOT
  (
    cd "$repo_root/mobile"
    ./gradlew --no-daemon \
      :api-client:ktlintCheck \
      :data:ktlintCheck \
      :composeApp:ktlintCheck \
      :composeApp:compileAndroidMain \
      :composeApp:compileAndroidHostTest
  )
fi
